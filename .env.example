# Copiá este archivo a .env.local y completá los valores.
# .env.local está en .gitignore: nunca subas las claves al repositorio.

# --- Supabase -------------------------------------------------------------
# Project Settings › Data API › Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Project Settings › API Keys › service_role (secret)
# Saltea RLS: solo se usa desde el servidor y nunca puede llegar al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Secretos de la aplicación --------------------------------------------
# Generá cada uno con:  openssl rand -hex 32
# (en PowerShell:  -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) }) )

# Clave con la que se derivan los hashes de los PIN.
# Si la cambiás, todos los PIN existentes dejan de funcionar.
PIN_PEPPER=

# Clave con la que se firman las cookies de sesión del panel.
# Si la cambiás, se cierran todas las sesiones abiertas.
SESSION_SECRET=
